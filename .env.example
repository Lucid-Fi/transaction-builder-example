# Optional, defaults to https://sandbox.api.pactlabs.com; staging: https://dev.lucidfinance.xyz
PACT_API_BASE_URL=
# Secret key (pactlabs_...), server only: Charon token mint
PACT_SECRET_KEY=
# Publishable key (pactlabs_pub_...), per-user calls together with the user token
PACT_PUBLISHABLE_KEY=
# Twilio is optional: leave TWILIO_API_KEY_SID empty to skip SMS codes (demo only).
# Twilio Verify service SID (VA...)
TWILIO_VERIFY_SERVICE_SID=
# API key SID (SK...) or Account SID (AC...); empty skips SMS codes and signs in any valid number
TWILIO_API_KEY_SID=
# API key secret, or Auth Token
TWILIO_API_KEY_SECRET=
# >= 32 random bytes, e.g. `openssl rand -base64 32`
SESSION_SECRET=
# Optional, defaults to localhost
WEBAUTHN_RP_ID=
# Optional passkey domain association, served under /.well-known (each route 404s when unset).
# Comma-separated full origins allowed to use passkeys for WEBAUTHN_RP_ID (/.well-known/webauthn)
WEBAUTHN_RELATED_ORIGINS=
# Comma-separated iOS app IDs, TEAMID.bundle.id (/.well-known/apple-app-site-association)
APPLE_APP_IDS=
# Android package name and comma-separated SHA-256 signing cert fingerprints, AA:BB:... (/.well-known/assetlinks.json)
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINTS=
# DEMO ONLY, not part of an integration: 0x-prefixed private key whose address pays gas for the
# MockUSDT demo faucet on /wallet. Empty turns the faucet off. Fund the address with Arbitrum Sepolia ETH.
DEMO_FAUCET_PRIVATE_KEY=
# DEMO ONLY: optional Arbitrum Sepolia RPC URL for the faucet; defaults to https://sepolia-rollup.arbitrum.io/rpc
DEMO_FAUCET_RPC_URL=
